{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "napm",
  "version": "0.1.4",
  "identifier": "com.napm.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "napm",
        "width": 880,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 660, "height": 420 },
        "appPosition": { "x": 165, "y": 250 },
        "applicationFolderPosition": { "x": 495, "y": 250 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwMUZBOTA0M0VFNzgyNzQKUldSMGd1YytCS2tmWUJiZ0ZqWXkzeC9OQVdkbVgwcm1sbkh4YnBGQVA5OGU2UWlBcEFsak4xK3UK",
      "endpoints": ["https://github.com/umzcio/napm/releases/latest/download/latest.json"]
    }
  }
}
